[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
scaling_3d/mode=4
scaling_3d/scale=0.58
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/ssao/quality=1
environment/ssao/half_size=true
environment/screen_space_reflection/half_size=true
textures/default_filters/anisotropic_filtering_level=3
reflections/sky_reflections/roughness_layers=8
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
moon_direction={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
sun_illuminance={
"type": "vec3",
"value": Vector3(12, 12, 12)
}
moon_illuminance={
"type": "vec3",
"value": Vector3(0.02, 0.02, 0.025)
}
mie_scale={
"type": "float",
"value": 1.0
}
ozone_scale={
"type": "float",
"value": 1.0
}
cloud_coverage={
"type": "float",
"value": 0.35
}
cloud_type={
"type": "float",
"value": 0.5
}
cloud_density={
"type": "float",
"value": 1.0
}
cloud_bottom={
"type": "float",
"value": 1.4
}
cloud_thickness={
"type": "float",
"value": 2.2
}
cloud_wind={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_evolve={
"type": "float",
"value": 0.0
}
cirrus_coverage={
"type": "float",
"value": 0.4
}
cirrus_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
star_rotation={
"type": "float",
"value": 0.0
}
night_factor={
"type": "float",
"value": 0.0
}
frame_jitter={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
rain_amount={
"type": "float",
"value": 0.0
}
world_wind={
"type": "vec2",
"value": Vector2(1, 0)
}
