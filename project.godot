; Engine configuration file.
; Hand-written; the editor will normalise it on first open.

config_version=5

[application]

config/name="Horyzont"
config/description="Spokojny road trip po wyspie, gdzie najważniejsze jest światło."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1200
window/size/mode=3
window/vsync/vsync_mode=1

